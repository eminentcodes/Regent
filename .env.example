# Walrus Memory (mainnet). Get these from a Walrus Memory login.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# LLM. Any OpenAI-compatible endpoint works (OpenRouter, Groq, Ollama, Gemini).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Database. A local file is fine for development, but a deployed server needs a
# hosted libsql database (Turso), because local files do not persist on it.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# App
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
TENANT_ID=regency
ADMIN_EMAILS=you@example.com

# Public origins. The storefront is a page inside this app at /store, so it needs
# no separate origin. Set NEXT_PUBLIC_STORE_URL to an absolute URL only when
# deploying it as its own site.
NEXT_PUBLIC_REGENT_URL=http://localhost:3002
NEXT_PUBLIC_STORE_URL=/store